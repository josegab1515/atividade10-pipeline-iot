# ==============================================================================
# Pipeline Meshtastic: Do Pacote Bruto ao Dado Útil (IAL220 - Atividade 10)
# ==============================================================================

# Prefixo obrigatório do aluno para tabelas MariaDB, coleções e chaves Redis
# Exemplo: jose_gabriel, gabriel, etc.
STUDENT_PREFIX=jose_gabriel

# ------------------------------------------------------------------------------
# MongoDB (Origem dos pacotes brutos - SOMENTE LEITURA)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://root:SUA_SENHA@HOST_DO_PROFESSOR:27017/?authSource=admin
MONGO_DB=iot
MONGO_COLLECTION=sensores

# ------------------------------------------------------------------------------
# MariaDB (Série Limpa, Agregados Hora/Dia e Quarentena)
# ------------------------------------------------------------------------------
MARIADB_HOST=HOST_MARIADB
MARIADB_PORT=3306
MARIADB_USER=SEU_USUARIO
MARIADB_PASSWORD=SUA_SENHA
MARIADB_DATABASE=fatec_iot

# ------------------------------------------------------------------------------
# Redis (Último Valor de cada métrica e Contadores de Monitoramento)
# ------------------------------------------------------------------------------
REDIS_HOST=HOST_REDIS
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# Parâmetros de Execução do Pipeline
# ------------------------------------------------------------------------------
# Tamanho do lote de leitura no MongoDB
BATCH_SIZE=100
# Intervalo de polling quando não houver novos registros (segundos)
POLL_INTERVAL=2
# Limiar para considerar silêncio/buraco de comunicação de um nó (em segundos, ex: 1800s = 30min)
SILENCE_THRESHOLD_SECONDS=1800
